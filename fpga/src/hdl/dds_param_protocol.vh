`ifndef DDS_PARAM_PROTOCOL_VH
`define DDS_PARAM_PROTOCOL_VH

// 参数 BRAM Mode0 频率快照协议常量。所有地址均为 BRAM 窗口内的字节偏移。
`define DDS_PARAM_ADDR_MAGIC       32'h0000_0000
`define DDS_PARAM_ADDR_VERSION     32'h0000_0004
`define DDS_PARAM_ADDR_GENERATION  32'h0000_0008
`define DDS_PARAM_ADDR_STATUS      32'h0000_000C
`define DDS_PARAM_ADDR_WORD_COUNT  32'h0000_0010
`define DDS_PARAM_ADDR_FORMAT      32'h0000_0014
`define DDS_PARAM_ADDR_FREQ_HZ     32'h0000_0040

`define DDS_PARAM_MAGIC            32'h5041_524D
`define DDS_PARAM_VERSION          32'h0001_0000
`define DDS_PARAM_WORD_COUNT       32'd1
`define DDS_PARAM_FORMAT_FREQ_HZ   32'd1

`define DDS_PARAM_STATUS_BUSY      2'd0
`define DDS_PARAM_STATUS_VALID     2'd1
`define DDS_PARAM_STATUS_ERROR     2'd2

`endif
